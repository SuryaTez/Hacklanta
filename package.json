{
  "name": "missionmesh",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && npm run css",
    "css": "tailwindcss -i src/app.css -o dist/app.css --minify",
    "css:watch": "tailwindcss -i src/app.css -o dist/app.css --watch",
    "test": "node tests/engine.test.mjs",
    "test:backend": "node scripts/run-python.mjs -m unittest tests.test_ai",
    "test:all": "npm test && npm run test:backend",
    "dev": "npm run build && node scripts/run-python.mjs server.py",
    "prestart": "npm run build",
    "watch": "node scripts/watch.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "test:workflow": "node scripts/workflow-check.mjs",
    "start": "node scripts/run-python.mjs server.py"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.28.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
